{
  "expo": {
    "name": "EventPlace",
    "slug": "event-place",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "eventplace",
    "userInterfaceStyle": "automatic",

    "locales": {
      "he": "./locales/he.json",
      "ar": "./locales/ar.json"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eventplace.app",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "he",
        "CFBundleLocalizations": [
          "he",
          "ar"
        ],
        "CFBundleAllowMixedLocalizations": true,
        "NSCameraUsageDescription": "This app needs camera access to take profile photos.",
        "NSPhotoLibraryUsageDescription": "This app needs photo library access to select profile images."
      }
    },
    "android": {
      "package": "com.eventplace.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-image",
      "expo-splash-screen",
      "expo-status-bar",
      [
        "expo-localization",
        {
          "supportedLocales": ["he", "ar"],
          "supportsRTL": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true,
      "eas": {
        "projectId": ""
      }
    }
  }
}
